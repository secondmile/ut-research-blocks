{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ut-research-blocks/slider",
	"title": "Slider",
	"description": "A carousel slider block for displaying multiple slides",
	"icon": "slides",
	"category": "ut-research",
	"example": {},
	"attributes": {
		"loop": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "start",
			"enum": [ "start", "center", "end" ]
		},
		"slidesPerViewMobile": {
			"type": "number",
			"default": 1.2
		},
		"slidesPerViewTablet": {
			"type": "number",
			"default": 2.3
		},
		"slidesPerViewDesktop": {
			"type": "number",
			"default": 3
		},
		"containerGapMobile": {
			"type": "string",
			"default": "0.75rem"
		},
		"containerGapTablet": {
			"type": "string",
			"default": "0.875rem"
		},
		"containerGapDesktop": {
			"type": "string",
			"default": "1rem"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "ut-research-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
